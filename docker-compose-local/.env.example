# Kopieren nach .env (cp .env.example .env). Die Datei .env ist per .gitignore ausgeschlossen.
# Diese Werte gelten nur für die lokale Entwicklung und haben mit AWS nichts zu tun.
DB_NAME=db_biztrips
DB_USER=trips
DB_PASSWORD=local-dev-password
DB_ROOT_PASSWORD=local-root-password

# Ports auf dem eigenen Rechner
FRONTEND_PORT=8081
BACKEND_PORT=8080

# Optional: Frontend aus lokalem Klon statt aus GitHub bauen
# FRONTEND_CONTEXT=../../refcard05-fe

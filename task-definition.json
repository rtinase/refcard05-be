{
  "family": "refcard05-be",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::${ACCOUNT_ID}:role/LabRole",
  "taskRoleArn": "arn:aws:iam::${ACCOUNT_ID}:role/LabRole",
  "containerDefinitions": [
    {
      "name": "refcard05-be",
      "image": "placeholder",
      "essential": true,
      "portMappings": [{ "containerPort": 8080, "protocol": "tcp" }],
      "environment": [
        { "name": "SPRING_PROFILES_ACTIVE", "value": "aws" },
        { "name": "DB_URL", "value": "jdbc:mariadb://${RDS_ENDPOINT}:3306/db_biztrips" },
        { "name": "DB_USER", "value": "admin" },
        { "name": "APP_STORAGE_S3_BUCKET", "value": "${S3_BUCKET}" },
        { "name": "APP_STORAGE_S3_REGION", "value": "${AWS_REGION}" },
        { "name": "APP_CORS_ALLOWED_ORIGINS", "value": "${FE_URL}" },
        { "name": "JAVA_TOOL_OPTIONS", "value": "-XX:MaxRAMPercentage=75" }
      ],
      "secrets": [
        { "name": "DB_PASSWORD", "valueFrom": "${DB_SECRET_ARN}" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -qO- http://127.0.0.1:8080/actuator/health > /dev/null || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 90
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/refcard05-be",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
